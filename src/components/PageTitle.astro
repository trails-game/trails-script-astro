---
import { AUTHOR_INFO } from '../data/authors';
import { getGameByPathname } from '../data/games';
import { stripBase, withBase } from '../utils/paths';

const entry = Astro.locals.starlightRoute.entry;
const pathname = stripBase(Astro.url.pathname);
const isHome = pathname === '/';
const is404 = entry.id === '404' || pathname === '/404' || pathname === '/404.html';
const authors = entry.data.authors ?? [];
const gameCtx = getGameByPathname(pathname);
---

{isHome ? null : is404 ? (
	<h1 id="_top">{entry.data.title}</h1>
) : (
	<div class="chapter-header" style={gameCtx ? `--arc-accent: ${gameCtx.arc.color}` : undefined}>
		{gameCtx && (
			<nav class="chapter-breadcrumbs print:hidden" aria-label="面包屑导航">
				<a href={withBase('/')}>首页</a>
				<span class="crumb-sep" aria-hidden="true">/</span>
				<a href={withBase(`/${gameCtx.game.prefix}/summary/`)}>{gameCtx.game.title}</a>
				<span class="crumb-sep" aria-hidden="true">/</span>
				<span class="crumb-current">{entry.data.title}</span>
				<span class="crumb-badges">
					<span class="crumb-arc-pill">
						<span class="crumb-arc-dot" aria-hidden="true"></span>
						<span>{gameCtx.arc.name}</span>
					</span>
					<span class="crumb-year-pill">{gameCtx.game.year}</span>
				</span>
			</nav>
		)}

		<h1 id="_top">{entry.data.title}</h1>

		<div class="page-meta-bar">
			{authors.length > 0 && (
				<ul class="metadata page-metadata">
					<li class="contributors">
						<span class="contributors-text">本页面由以下成员整理提供:</span>
						<ul class="contributors">
							{authors.map((key) => {
								const info = AUTHOR_INFO[key];
								return info ? (
									<li>
										<a href={info.link} target="_blank" rel="noopener noreferrer">
											<img
												class="avatar"
												src={info.avatar}
												alt={info.name}
												width="32"
												height="32"
												loading="lazy"
											/>
											<span>{info.name}</span>
										</a>
									</li>
								) : (
									<li>
										<span>{key}</span>
									</li>
								);
							})}
						</ul>
					</li>
				</ul>
			)}

			<div class="reader-toolbar print:hidden" role="group" aria-label="阅读器设置">
				<button
					type="button"
					class="reader-ctrl-btn"
					data-reader-mode-toggle
					title="切换剧场排版与纯文本模式"
				>
					<span class="ctrl-label">排版</span>
					<span class="ctrl-value" data-mode-label>剧场</span>
				</button>

				<div class="reader-font-group" role="group" aria-label="字体大小">
					<span class="ctrl-label">字号</span>
					<button type="button" class="font-step-btn" data-reader-font-btn="sm">小</button>
					<button type="button" class="font-step-btn" data-reader-font-btn="md">标准</button>
					<button type="button" class="font-step-btn" data-reader-font-btn="lg">大</button>
				</div>

				<button
					type="button"
					class="reader-ctrl-btn"
					data-reader-width-toggle
					title="切换舒适页宽与宽屏阅读"
				>
					<span class="ctrl-label">页宽</span>
					<span class="ctrl-value" data-width-label>舒适</span>
				</button>
			</div>
		</div>
	</div>
)}

<script>
	const PREFS_KEY = 'trails-reader-prefs';
	interface ReaderPrefs {
		font: 'sm' | 'md' | 'lg';
		width: 'normal' | 'wide';
		mode: 'enhanced' | 'raw';
	}

	function loadPrefs(): ReaderPrefs {
		try {
			const raw = localStorage.getItem(PREFS_KEY);
			if (raw) {
				const parsed = JSON.parse(raw);
				return {
					font: parsed.font === 'sm' || parsed.font === 'lg' ? parsed.font : 'md',
					width: parsed.width === 'wide' ? 'wide' : 'normal',
					mode: parsed.mode === 'raw' ? 'raw' : 'enhanced',
				};
			}
		} catch {}
		return { font: 'md', width: 'normal', mode: 'enhanced' };
	}

	function applyPrefs(prefs: ReaderPrefs) {
		const root = document.documentElement;
		root.dataset.readerFont = prefs.font;
		root.dataset.readerWidth = prefs.width;
		root.dataset.scriptMode = prefs.mode;

		document.querySelectorAll<HTMLButtonElement>('[data-reader-font-btn]').forEach((btn) => {
			btn.setAttribute('aria-pressed', btn.dataset.readerFontBtn === prefs.font ? 'true' : 'false');
		});

		const modeBtn = document.querySelector<HTMLButtonElement>('[data-reader-mode-toggle]');
		const modeLabel = document.querySelector('[data-mode-label]');
		if (modeBtn && modeLabel) {
			modeBtn.setAttribute('aria-pressed', prefs.mode === 'enhanced' ? 'true' : 'false');
			modeLabel.textContent = prefs.mode === 'enhanced' ? '剧场' : '纯文本';
		}

		const widthBtn = document.querySelector<HTMLButtonElement>('[data-reader-width-toggle]');
		const widthLabel = document.querySelector('[data-width-label]');
		if (widthBtn && widthLabel) {
			widthBtn.setAttribute('aria-pressed', prefs.width === 'wide' ? 'true' : 'false');
			widthLabel.textContent = prefs.width === 'wide' ? '宽屏' : '舒适';
		}
	}

	function savePrefs(prefs: ReaderPrefs) {
		try {
			localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
		} catch {}
	}

	const prefs = loadPrefs();
	applyPrefs(prefs);

	document.querySelectorAll<HTMLButtonElement>('[data-reader-font-btn]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const val = btn.dataset.readerFontBtn;
			if (val === 'sm' || val === 'md' || val === 'lg') {
				prefs.font = val;
				applyPrefs(prefs);
				savePrefs(prefs);
			}
		});
	});

	document.querySelector('[data-reader-mode-toggle]')?.addEventListener('click', () => {
		prefs.mode = prefs.mode === 'enhanced' ? 'raw' : 'enhanced';
		applyPrefs(prefs);
		savePrefs(prefs);
	});

	document.querySelector('[data-reader-width-toggle]')?.addEventListener('click', () => {
		prefs.width = prefs.width === 'wide' ? 'normal' : 'wide';
		applyPrefs(prefs);
		savePrefs(prefs);
	});
</script>

<style>
	@layer starlight.core {
		.chapter-header {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
		}

		.chapter-breadcrumbs {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.4rem;
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}

		.chapter-breadcrumbs a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.chapter-breadcrumbs a:hover {
			color: var(--arc-accent, var(--sl-color-text-accent));
			text-decoration: underline;
		}

		.crumb-current {
			color: var(--sl-color-white);
			font-weight: 600;
		}

		.crumb-badges {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			margin-left: auto;
		}

		.crumb-arc-pill {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			padding: 0.14rem 0.55rem;
			border-radius: 9999px;
			border: 1px solid var(--archive-border);
			background: var(--archive-pill-bg);
			color: var(--sl-color-gray-2);
			font-weight: 600;
		}

		.crumb-arc-dot {
			width: 0.38rem;
			height: 0.38rem;
			border-radius: 9999px;
			background: var(--arc-accent, var(--sl-color-text-accent));
		}

		.crumb-year-pill {
			font-family: var(--sl-font-mono);
			padding: 0.14rem 0.5rem;
			border-radius: 9999px;
			border: 1px solid color-mix(in srgb, var(--arc-accent, var(--sl-color-text-accent)) 40%, transparent);
			background: var(--archive-pill-bg);
			color: var(--arc-accent, var(--sl-color-text-accent));
			font-weight: 700;
		}

		h1 {
			margin: 0.2rem 0 0;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 700;
			color: var(--sl-color-white);
		}

		.page-meta-bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem 1rem;
			padding-top: 0.35rem;
		}

		.reader-toolbar {
			display: inline-flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.45rem;
			margin-left: auto;
		}

		.reader-ctrl-btn,
		.reader-font-group {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			padding: 0.25rem 0.55rem;
			border-radius: 0.55rem;
			border: 1px solid var(--archive-border);
			background: var(--archive-surface);
			color: var(--sl-color-gray-2);
			font-size: 0.75rem;
		}

		.reader-ctrl-btn {
			cursor: pointer;
			transition: border-color 0.15s ease, color 0.15s ease;
		}

		.reader-ctrl-btn:hover {
			border-color: var(--sl-color-text-accent);
			color: var(--sl-color-white);
		}

		.ctrl-label {
			color: var(--sl-color-gray-3);
			font-weight: 600;
		}

		.ctrl-value {
			color: var(--sl-color-text-accent);
			font-weight: 700;
		}

		.font-step-btn {
			padding: 0.1rem 0.38rem;
			border: 0;
			border-radius: 0.35rem;
			background: transparent;
			color: var(--sl-color-gray-2);
			font-size: 0.75rem;
			font-weight: 600;
			cursor: pointer;
		}

		.font-step-btn[aria-pressed='true'] {
			background: var(--sl-color-text-accent);
			color: var(--sl-color-text-invert);
		}
	}
</style>
