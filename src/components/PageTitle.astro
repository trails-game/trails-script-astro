---
import { AUTHOR_INFO } from '../data/authors';
import { getGameByPathname } from '../data/games';
import { stripBase, withBase } from '../utils/paths';

const entry = Astro.locals.starlightRoute.entry;
const pathname = stripBase(Astro.url.pathname);
const isHome = pathname === '/';
const is404 = entry.id === '404' || pathname === '/404' || pathname === '/404.html';
const authors = entry.data.authors ?? [];
const gameCtx = getGameByPathname(pathname);

function detectScriptContent(rawBody: string | undefined, entryId: string): boolean {
	if (!rawBody) return false;
	if (entryId === '404' || entryId === 'index' || entryId === 'summary' || entryId.endsWith('/summary')) {
		return false;
	}
	const lines = rawBody.split(/\r?\n|<br\s*\/?>/i);
	for (const rawLine of lines) {
		const line = rawLine.trim();
		if (!line) continue;
		if (/!\[|\]\(|<(?:audio|source|img|a|table)\b/i.test(line)) continue;
		if (/^(?:\*\*|<strong>)?\s*(?:【(?:场景|剧情时间|时间|章节标题|角色介绍)】|——)/.test(line)) {
			return true;
		}
		if (/^(?:【[^】<>\n]+】|（[^）<>\n]+）)$/.test(line)) {
			return true;
		}
		if (
			!/^\d{1,2}：\d{2}\b/.test(line) &&
			/^(?:【[^】<>\n]{1,20}】|[^：:<>\n【（(“"「『※*\s#|-][^：:<>\n【（(]{0,20})：\s*\S/.test(line)
		) {
			return true;
		}
		if (/\{(?![.:])[^{}<>\n]{1,45}\}/.test(line)) {
			return true;
		}
	}
	return false;
}

const showScriptModeToggle = detectScriptContent(entry.body, entry.id);
---

{isHome ? null : is404 ? (
	<h1 id="_top">{entry.data.title}</h1>
) : (
	<div class="chapter-header" style={gameCtx ? `--arc-accent: ${gameCtx.arc.color}` : undefined}>
		{gameCtx && (
			<nav class="chapter-breadcrumbs print:hidden" aria-label="面包屑导航">
				<a href={withBase('/')}>首页</a>
				<span class="crumb-sep" aria-hidden="true">/</span>
				<a href={withBase(`/${gameCtx.game.prefix}/summary/`)}>{gameCtx.game.title}</a>
				<span class="crumb-sep" aria-hidden="true">/</span>
				<span class="crumb-current">{entry.data.title}</span>
				<span class="crumb-badges">
					<span class="crumb-arc-pill">
						<span class="crumb-arc-dot" aria-hidden="true"></span>
						<span>{gameCtx.arc.name}</span>
					</span>
					<span class="crumb-year-pill">{gameCtx.game.year}</span>
				</span>
			</nav>
		)}

		<h1 id="_top">{entry.data.title}</h1>

		<div class="page-meta-bar">
			{authors.length > 0 && (
				<ul class="metadata page-metadata">
					<li class="contributors">
						<span class="contributors-text">本页面由以下成员整理提供:</span>
						<ul class="contributors">
							{authors.map((key) => {
								const info = AUTHOR_INFO[key];
								return info ? (
									<li>
										<a href={info.link} target="_blank" rel="noopener noreferrer">
											<img
												class="avatar"
												src={info.avatar}
												alt={info.name}
												width="32"
												height="32"
												loading="lazy"
											/>
											<span>{info.name}</span>
										</a>
									</li>
								) : (
									<li>
										<span>{key}</span>
									</li>
								);
							})}
						</ul>
					</li>
				</ul>
			)}

			<div class="reader-toolbar print:hidden" role="group" aria-label="阅读器设置">
				{showScriptModeToggle && (
					<div class="reader-mode-group" data-reader-mode-group>
						<button
							type="button"
							class="reader-ctrl-btn reader-mode-btn"
							data-reader-mode-toggle
						>
							<span class="ctrl-label">排版</span>
							<span class="ctrl-value" data-mode-label>剧场</span>
						</button>
						<button
							type="button"
							class="reader-help-btn"
							data-reader-help-btn
							aria-label="排版模式说明"
							aria-expanded="false"
							aria-controls="reader-mode-popover"
						>
							<span class="help-icon" aria-hidden="true">?</span>
						</button>

						<div
							id="reader-mode-popover"
							class="reader-help-popover print:hidden"
							role="tooltip"
							data-reader-help-popover
							hidden
						>
							<div class="popover-title">剧本排版模式说明</div>
							<div class="popover-section">
								<div class="popover-item-head">
									<span class="popover-badge is-theater">剧场</span>
									<span class="popover-item-title">沉浸式剧本排版（默认）</span>
								</div>
								<p class="popover-desc">
									自动识别并高亮角色名标签、场景与时间横幅、动作神态提示及专有名词注音胶囊。
								</p>
								<div class="popover-sample is-theater" aria-hidden="true">
									<span class="sample-speaker">艾丝蒂尔</span>
									<span>
										这就是导力器<span class="sample-gloss">战术导力器</span>吗？
									</span>
								</div>
							</div>
							<div class="popover-section">
								<div class="popover-item-head">
									<span class="popover-badge">纯文本</span>
									<span class="popover-item-title">原始文本排版</span>
								</div>
								<p class="popover-desc">
									还原「角色：台词」与「&#123;注音&#125;」原始格式，便于整段复制摘录或极简阅读。
								</p>
								<div class="popover-sample is-raw" aria-hidden="true">
									艾丝蒂尔：这就是导力器&#123;战术导力器&#125;吗？
								</div>
							</div>
						</div>
					</div>
				)}

				<div class="reader-font-group" role="group" aria-label="字体大小">
					<span class="ctrl-label">字号</span>
					<button type="button" class="font-step-btn" data-reader-font-btn="sm">小</button>
					<button type="button" class="font-step-btn" data-reader-font-btn="md">标准</button>
					<button type="button" class="font-step-btn" data-reader-font-btn="lg">大</button>
				</div>

				<button
					type="button"
					class="reader-ctrl-btn"
					data-reader-width-toggle
					title="切换舒适页宽与宽屏阅读"
				>
					<span class="ctrl-label">页宽</span>
					<span class="ctrl-value" data-width-label>舒适</span>
				</button>
			</div>
		</div>
	</div>
)}

<script>
	const PREFS_KEY = 'trails-reader-prefs';
	interface ReaderPrefs {
		font: 'sm' | 'md' | 'lg';
		width: 'normal' | 'wide';
		mode: 'enhanced' | 'raw';
	}

	function loadPrefs(): ReaderPrefs {
		try {
			const raw = localStorage.getItem(PREFS_KEY);
			if (raw) {
				const parsed = JSON.parse(raw);
				return {
					font: parsed.font === 'sm' || parsed.font === 'lg' ? parsed.font : 'md',
					width: parsed.width === 'wide' ? 'wide' : 'normal',
					mode: parsed.mode === 'raw' ? 'raw' : 'enhanced',
				};
			}
		} catch {}
		return { font: 'md', width: 'normal', mode: 'enhanced' };
	}

	function applyPrefs(prefs: ReaderPrefs) {
		const root = document.documentElement;
		root.dataset.readerFont = prefs.font;
		root.dataset.readerWidth = prefs.width;
		root.dataset.scriptMode = prefs.mode;

		document.querySelectorAll<HTMLButtonElement>('[data-reader-font-btn]').forEach((btn) => {
			btn.setAttribute('aria-pressed', btn.dataset.readerFontBtn === prefs.font ? 'true' : 'false');
		});

		const modeBtn = document.querySelector<HTMLButtonElement>('[data-reader-mode-toggle]');
		const modeLabel = document.querySelector('[data-mode-label]');
		if (modeBtn && modeLabel) {
			modeBtn.setAttribute('aria-pressed', prefs.mode === 'enhanced' ? 'true' : 'false');
			modeLabel.textContent = prefs.mode === 'enhanced' ? '剧场' : '纯文本';
		}

		const widthBtn = document.querySelector<HTMLButtonElement>('[data-reader-width-toggle]');
		const widthLabel = document.querySelector('[data-width-label]');
		if (widthBtn && widthLabel) {
			widthBtn.setAttribute('aria-pressed', prefs.width === 'wide' ? 'true' : 'false');
			widthLabel.textContent = prefs.width === 'wide' ? '宽屏' : '舒适';
		}
	}

	function savePrefs(prefs: ReaderPrefs) {
		try {
			localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
		} catch {}
	}

	const prefs = loadPrefs();
	applyPrefs(prefs);

	document.querySelectorAll<HTMLButtonElement>('[data-reader-font-btn]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const val = btn.dataset.readerFontBtn;
			if (val === 'sm' || val === 'md' || val === 'lg') {
				prefs.font = val;
				applyPrefs(prefs);
				savePrefs(prefs);
			}
		});
	});

	document.querySelector('[data-reader-mode-toggle]')?.addEventListener('click', () => {
		prefs.mode = prefs.mode === 'enhanced' ? 'raw' : 'enhanced';
		applyPrefs(prefs);
		savePrefs(prefs);
	});

	document.querySelector('[data-reader-width-toggle]')?.addEventListener('click', () => {
		prefs.width = prefs.width === 'wide' ? 'normal' : 'wide';
		applyPrefs(prefs);
		savePrefs(prefs);
	});

	const helpBtn = document.querySelector<HTMLButtonElement>('[data-reader-help-btn]');
	const popover = document.querySelector<HTMLElement>('[data-reader-help-popover]');
	if (helpBtn && popover) {
		if (popover.parentElement !== document.body) {
			document.body.appendChild(popover);
		}

		let pinned = false;
		let closeTimer: number | undefined;

		const clearCloseTimer = () => {
			if (closeTimer !== undefined) {
				window.clearTimeout(closeTimer);
				closeTimer = undefined;
			}
		};

		const positionPopover = () => {
			if (popover.hidden) return;
			const rect = helpBtn.getBoundingClientRect();
			const pw = popover.offsetWidth;
			const ph = popover.offsetHeight;
			const vw = window.innerWidth;
			const vh = window.innerHeight;
			const margin = 12;

			const left = Math.min(Math.max(margin, rect.right - pw), Math.max(margin, vw - pw - margin));
			let top = rect.bottom + 8;
			if (top + ph > vh - margin && rect.top - 8 - ph >= margin) {
				top = rect.top - 8 - ph;
			} else {
				top = Math.min(top, Math.max(margin, vh - ph - margin));
			}

			popover.style.left = `${Math.round(left)}px`;
			popover.style.top = `${Math.round(top)}px`;
		};

		const syncExpanded = () => {
			helpBtn.setAttribute('aria-expanded', popover.hidden ? 'false' : 'true');
		};

		const openPopover = () => {
			clearCloseTimer();
			if (popover.hidden) {
				popover.style.visibility = 'hidden';
				popover.hidden = false;
				positionPopover();
				popover.style.visibility = '';
			} else {
				positionPopover();
			}
			syncExpanded();
		};

		const closePopover = () => {
			clearCloseTimer();
			if (!popover.hidden) {
				popover.hidden = true;
			}
			syncExpanded();
		};

		const scheduleHoverClose = () => {
			clearCloseTimer();
			closeTimer = window.setTimeout(() => {
				if (!pinned) {
					closePopover();
				}
			}, 150);
		};

		helpBtn.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') {
				openPopover();
			}
		});

		helpBtn.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse' && !pinned) {
				scheduleHoverClose();
			}
		});

		popover.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse') {
				clearCloseTimer();
			}
		});

		popover.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse' && !pinned) {
				scheduleHoverClose();
			}
		});

		helpBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			if (popover.hidden) {
				pinned = true;
				openPopover();
			} else if (pinned) {
				pinned = false;
				closePopover();
			} else {
				pinned = true;
				syncExpanded();
			}
		});

		helpBtn.addEventListener('focus', () => {
			if (helpBtn.matches(':focus-visible')) {
				openPopover();
			}
		});

		helpBtn.addEventListener('blur', () => {
			if (!pinned) {
				scheduleHoverClose();
			}
		});

		document.addEventListener('pointerdown', (e) => {
			const target = e.target as Node | null;
			if (!popover.hidden && target && !helpBtn.contains(target) && !popover.contains(target)) {
				pinned = false;
				closePopover();
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !popover.hidden) {
				pinned = false;
				closePopover();
				helpBtn.focus();
			}
		});

		window.addEventListener('scroll', positionPopover, { passive: true });
		window.addEventListener('resize', positionPopover, { passive: true });
	}
</script>

<style>
	@layer starlight.core {
		.chapter-header {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
		}

		.chapter-breadcrumbs {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.4rem;
			font-size: var(--sl-text-xs);
			color: var(--sl-color-gray-3);
		}

		.chapter-breadcrumbs a {
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.chapter-breadcrumbs a:hover {
			color: var(--arc-accent, var(--sl-color-text-accent));
			text-decoration: underline;
		}

		.crumb-current {
			color: var(--sl-color-white);
			font-weight: 600;
		}

		.crumb-badges {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			margin-left: auto;
		}

		.crumb-arc-pill {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			padding: 0.14rem 0.55rem;
			border-radius: 9999px;
			border: 1px solid var(--archive-border);
			background: var(--archive-pill-bg);
			color: var(--sl-color-gray-2);
			font-weight: 600;
		}

		.crumb-arc-dot {
			width: 0.38rem;
			height: 0.38rem;
			border-radius: 9999px;
			background: var(--arc-accent, var(--sl-color-text-accent));
		}

		.crumb-year-pill {
			font-family: var(--sl-font-mono);
			padding: 0.14rem 0.5rem;
			border-radius: 9999px;
			border: 1px solid color-mix(in srgb, var(--arc-accent, var(--sl-color-text-accent)) 40%, transparent);
			background: var(--archive-pill-bg);
			color: var(--arc-accent, var(--sl-color-text-accent));
			font-weight: 700;
		}

		h1 {
			margin: 0.2rem 0 0;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 700;
			color: var(--sl-color-white);
		}

		.page-meta-bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem 1rem;
			padding-top: 0.35rem;
		}

		.reader-toolbar {
			display: inline-flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.45rem;
			margin-left: auto;
		}

		.reader-ctrl-btn,
		.reader-font-group,
		.reader-mode-group {
			display: inline-flex;
			align-items: center;
			border-radius: 0.55rem;
			border: 1px solid var(--archive-border);
			background: var(--archive-surface);
			color: var(--sl-color-gray-2);
			font-size: 0.75rem;
		}

		.reader-ctrl-btn,
		.reader-font-group {
			gap: 0.35rem;
			padding: 0.25rem 0.55rem;
		}

		.reader-ctrl-btn {
			cursor: pointer;
			transition: border-color 0.15s ease, color 0.15s ease;
		}

		.reader-ctrl-btn:hover {
			border-color: var(--sl-color-text-accent);
			color: var(--sl-color-white);
		}

		.reader-mode-group {
			align-items: stretch;
			overflow: hidden;
			transition: border-color 0.15s ease;
		}

		.reader-mode-group[hidden] {
			display: none;
		}

		.reader-mode-group:has(.reader-mode-btn:hover),
		.reader-mode-group:has(.reader-help-btn:hover),
		.reader-mode-group:has(.reader-help-btn[aria-expanded='true']) {
			border-color: var(--sl-color-text-accent);
		}

		.reader-mode-btn {
			border: 0;
			border-radius: 0;
			background: transparent;
		}

		.reader-help-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 1.7rem;
			padding: 0.25rem 0.42rem;
			border: 0;
			border-inline-start: 1px solid var(--archive-border);
			background: transparent;
			color: var(--sl-color-gray-3);
			cursor: pointer;
			transition: background-color 0.15s ease, color 0.15s ease;
		}

		.reader-help-btn .help-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1rem;
			height: 1rem;
			border-radius: 9999px;
			border: 1px solid currentColor;
			font-size: 0.68rem;
			font-weight: 700;
			line-height: 1;
		}

		.reader-help-btn:hover,
		.reader-help-btn[aria-expanded='true'] {
			background: var(--archive-pill-bg);
			color: var(--sl-color-text-accent);
		}

		.ctrl-label {
			color: var(--sl-color-gray-3);
			font-weight: 600;
		}

		.ctrl-value {
			color: var(--sl-color-text-accent);
			font-weight: 700;
		}

		.font-step-btn {
			padding: 0.1rem 0.38rem;
			border: 0;
			border-radius: 0.35rem;
			background: transparent;
			color: var(--sl-color-gray-2);
			font-size: 0.75rem;
			font-weight: 600;
			cursor: pointer;
		}

		.font-step-btn[aria-pressed='true'] {
			background: var(--sl-color-text-accent);
			color: var(--sl-color-text-invert);
		}

		.reader-help-popover {
			position: fixed;
			z-index: 70;
			width: min(21rem, calc(100vw - 1.5rem));
			padding: 0.85rem 0.95rem;
			border-radius: 0.8rem;
			border: 1px solid var(--archive-border-strong);
			background: var(--archive-surface-elevated);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
			box-shadow: var(--sl-shadow-lg);
			color: var(--sl-color-gray-2);
			display: flex;
			flex-direction: column;
			gap: 0.7rem;
			font-size: 0.78rem;
			line-height: 1.55;
		}

		.reader-help-popover[hidden] {
			display: none;
		}

		.popover-title {
			font-size: 0.82rem;
			font-weight: 700;
			color: var(--sl-color-white);
			padding-bottom: 0.45rem;
			border-bottom: 1px solid var(--archive-border);
		}

		.popover-section {
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
		}

		.popover-item-head {
			display: flex;
			align-items: center;
			gap: 0.45rem;
		}

		.popover-badge {
			display: inline-flex;
			align-items: center;
			padding: 0.08rem 0.42rem;
			border-radius: 0.35rem;
			border: 1px solid var(--archive-border);
			background: var(--archive-pill-bg);
			color: var(--sl-color-gray-2);
			font-size: 0.7rem;
			font-weight: 700;
		}

		.popover-badge.is-theater {
			border-color: var(--archive-border-strong);
			background: var(--archive-gloss-bg);
			color: var(--sl-color-text-accent);
		}

		.popover-item-title {
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.popover-desc {
			margin: 0;
			color: var(--sl-color-gray-3);
			font-size: 0.74rem;
		}

		.popover-sample {
			padding: 0.38rem 0.55rem;
			border-radius: 0.45rem;
			border: 1px solid var(--archive-border);
			background: var(--archive-pill-bg);
			font-size: 0.74rem;
			color: var(--sl-color-gray-1);
		}

		.popover-sample.is-raw {
			font-family: var(--sl-font-mono);
			color: var(--sl-color-gray-2);
		}

		.sample-speaker {
			display: inline-block;
			padding: 0.02rem 0.42rem;
			margin-right: 0.25rem;
			border-radius: 0.32rem;
			font-weight: 700;
			background: var(--archive-gloss-bg);
			color: var(--sl-color-text-accent);
		}

		.sample-gloss {
			display: inline;
			padding: 0.01rem 0.3rem;
			margin: 0 0.12rem;
			border-radius: 0.3rem;
			border: 1px solid var(--archive-gloss-border);
			background: var(--archive-gloss-bg);
			font-size: 0.86em;
			color: var(--sl-color-text-accent);
		}
	}
</style>
